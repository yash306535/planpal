# PlanPal environment variables — ALL server-side only, never exposed to the client.
# Copy to .env.local (or .env) and fill in. The app runs fully in mock mode with
# everything below left blank, so you can demo it with no keys at all.

# ---- Anthropic Claude (plan generation) ----
# Get a key at https://console.anthropic.com/. Leave blank to use the mock planner.
ANTHROPIC_API_KEY=
# Model id is read from env so it can be swapped without code changes.
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Tavus (the "Talk to your planner" live video) ----
# Dashboard: https://platform.tavus.io/
#   • API key:    Account → API Keys
#   • Replica ID: Replicas page (ids look like "r1a2b3c4d5"), or create a stock replica
#   • Persona ID: Personas page (ids look like "p1a2b3c4d5"), or use a default persona
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=

# ---- Demo switch ----
# Set to "true" to force the deterministic seeded plan and skip all external calls.
MOCK_MODE=false
